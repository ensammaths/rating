# Set automatically when you connect Upstash Redis in Vercel → Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Password for the dashboard and results pages. Student links stay public.
ADMIN_PASSWORD=

# Optional: address used in student links/QR codes (e.g. a custom domain).
# Defaults to the Vercel production domain.
SITE_URL=
